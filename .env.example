# DeepSeek LLM
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ASR：指向 GGML 模型；README 中提供下载命令
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo-q5_0.bin

# 存储路径（相对项目根或绝对路径均可）
DATA_DIR=data
DB_PATH=data/meetings.db
KNOWLEDGE_DIR=knowledge

# 服务
HOST=127.0.0.1
PORT=8000
