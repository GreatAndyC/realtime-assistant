# DeepSeek LLM
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ASR：指向本机 Buzz 附带的 Large-v3-Turbo GGML 权重
# 例如：/Users/yourname/Library/Application Support/Buzz/models/ggml-large-v3-turbo.bin
WHISPER_MODEL_PATH=/path/to/ggml-large-v3-turbo.bin

# 存储路径（相对项目根或绝对路径均可）
DATA_DIR=data
DB_PATH=data/meetings.db
KNOWLEDGE_DIR=knowledge

# 服务
HOST=0.0.0.0
PORT=8000
