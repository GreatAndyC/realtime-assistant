# DeepSeek LLM
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ASR：火山引擎豆包 2.0 实时流式识别
VOLC_API_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
TTS_PROVIDER=system
# 开通火山“语音合成2.0”后，可改为 volcengine；复用 VOLC_API_KEY。
# VOLC_TTS_VOICE_ZH=zh_female_vv_uranus_bigtts
# VOLC_TTS_VOICE_YUE=支持粤语的音色 ID（需从火山音色库选择）

# 存储路径（相对项目根或绝对路径均可）
DATA_DIR=data
DB_PATH=data/meetings.db
KNOWLEDGE_DIR=knowledge

# 服务
HOST=127.0.0.1
PORT=8000
